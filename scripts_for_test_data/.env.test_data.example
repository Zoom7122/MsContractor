

#Запуск
#"python3 mscontractor_create_counterparty_docs.py"



MS_LOGIN=
MS_PASSWORD=

MS_BASE_URL=https://api.moysklad.ru/api/remap/1.2
MS_COUNTERPARTY_COUNT=3
# Количество документов каждого выбранного типа на один КА.
# Для 1000 документов каждого типа укажи: MS_DOCUMENTS_PER_TYPE=1000
MS_DOCUMENTS_PER_TYPE=1
MS_COUNTERPARTY_NAME='DOCS TEST 567'
MS_COUNTERPARTY_PHONE=+79990000000
TEST_MARKED_PRODUCT_ID=
TEST_TRACKING_CODE=
TEST_RETIRE_ORDER_TYPE=
TEST_SUPPORTING_TRANSACTION=
MS_WRITE_REPORT_JSON=true
MS_REQUEST_DELAY_SECONDS=0.25

#
# Основные тестовые документы.
#MS_DOCUMENT_TYPES=customerorder, demand, purchaseorder, supply, paymentin, paymentout, cashin, cashout, loss, retaildemand, invoiceout, invoicein, counterpartyadjustment, commissionreportin, commissionreportout, salesreturn, purchasereturn, retailsalesreturn, factureout, facturein, retireorder
#MS_DOCUMENT_TYPES=salesreturn,purchasereturn,retailsalesreturn,factureout,facturein
#MS_DOCUMENT_TYPES=salesreturn,factureout,paymentout,cashout,loss,facturein
# Вложенные документы создаются для каждого выбранного salesreturn/purchasereturn.
# Один и тот же тип можно указать в обоих списках: тогда он создастся в обоих сценариях.
# Для salesreturn facturein создаётся на paymentout, потому что прямой связи
# facturein с salesreturn в API MoySklad нет.
# Для purchasereturn facturein создаются два документа: на supply и отдельно
# привязанный к самому возврату через поле purchasereturn.factureIn. Для второго
# документа supply используется как обязательное API-основание.
#MS_SALESRETURN_DOCUMENTS=factureout,paymentout,cashout,loss,facturein
#MS_PURCHASERETURN_DOCUMENTS=facturein,factureout,paymentin,cashin
# Для этих документов скрипт автоматически добавит необходимые основания:
# demand для salesreturn и отдельного factureout, supply для purchasereturn
# и facturein,
# retaildemand для retailsalesreturn.
#MS_DOCUMENT_TYPES=salesreturn,purchasereturn,retailsalesreturn,factureout,facturein
# Если MS_DOCUMENT_TYPES содержит facturein, автоматически создаются:
# supply -> facturein/paymentout/purchasereturn/cashout,
# а затем paymentout -> facturein. Для purchasereturn и cashout ссылка на уже
# созданный supply-фактуру передаётся сразу при создании этих документов.
# Если MS_DOCUMENT_TYPES содержит factureout, автоматически создаётся demand,
# а на нём документы из MS_DEMAND_DOCUMENTS (по умолчанию все четыре):
# demand -> factureout/paymentin/salesreturn/cashin, затем
# paymentin -> factureout и cashin -> factureout (через payments).
# factureout на salesreturn JSON API МойСклад не создаёт — задание пропускается.
#MS_DEMAND_DOCUMENTS=factureout,paymentin,salesreturn,cashin
# Дополнительные документы: зависят от активной точки продаж или маркировки.
#MS_DOCUMENT_TYPES_OPTIONAL=retaildemand,retailsalesreturn,retireorder
