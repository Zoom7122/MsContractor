# Скопируйте в .env (файл игнорируется git) или задайте переменные окружения.
# Переменные окружения имеют приоритет над файлом. Значения ниже — заполнители.

# Авторизация: токен ИЛИ логин и пароль. Токен имеет приоритет.
MS_TOKEN=
MS_LOGIN=
MS_PASSWORD=

# JSON API 1.2 (HTTPS, путь /api/remap/1.2/)
MS_BASE_URL=https://api.moysklad.ru/api/remap/1.2/

# Необязательно: какие существующие сущности аккаунта использовать.
# По умолчанию берутся первая неархивная организация и первый неархивный склад.
MS_RELTEST_ORGANIZATION_ID=
MS_RELTEST_STORE_ID=

# Точка продаж для сценария retail-flow. Без неё сценарий пропускается:
# генератор не открывает смену на произвольной точке продаж.
MS_RELTEST_RETAIL_STORE_ID=

# Минимальный интервал между запросами, мс (не меньше 100).
MS_RELTEST_MIN_REQUEST_INTERVAL_MS=400
