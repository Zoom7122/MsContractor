FROM node:20-bookworm

WORKDIR /frontend-Iframe

ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

COPY frontend-Iframe/package.json frontend-Iframe/package-lock.json ./

RUN npm ci

COPY frontend-Iframe ./

RUN npm run build

EXPOSE 4174

CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "4174"]

