EGRESS_MOYSKLAD_REQUEST_TIMEOUT=00:30:30
MERGE_DOCUMENT_DISCOVERY_TIMEOUT=05:00:00
MERGE_CONSUMER_MAX_POLL_INTERVAL_MS=3960000
DOCUMENTS_PUT_CHANGE=customerorder,demand,invoiceout,invoicein,supply,purchaseorder,paymentin,paymentout,cashin,cashout,retaildemand,counterpartyadjustment,commissionreportout,commissionreportin
DOCUMENTS_CHANGE_AGENT_AND_CONTRACT=commissionreportout,commissionreportin
DOCUMENTS_DISCOVERY=customerorder,demand,invoiceout,invoicein,supply,purchaseorder,paymentin,paymentout,cashin,cashout,retaildemand,counterpartyadjustment,commissionreportin,commissionreportout,purchasereturn,salesreturn,retailsalesreturn,factureout,facturein
DOCUMENTS_MERGE_EXCLUDE=
