# Local Egress process example. Copy to .env in the service working directory.
# Docker Compose uses the repository-root .env.dev or .env.prod instead.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:8082

# Required service dependencies. Use the same internal API key as VendorService.
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=mscontractor;Username=mscontractor;Password=change-me
Redis__ConnectionString=localhost:6379
InternalApi__Key=replace-with-the-shared-internal-api-key
Services__VendorService__BaseUrl=http://localhost:5011/

# MoySklad JSON API
MoySklad__JsonApiBaseUrl=https://api.moysklad.ru/api/remap/1.2/
MoySklad__RequestTimeout=00:00:30
PURCHASERETURN_SUPPLY_MAX_RETRIES=2

# Required comma-separated document type lists
DOCUMENTS_PUT_CHANGE=customerorder,demand,invoiceout,invoicein,supply,purchaseorder,paymentin,paymentout,cashin,cashout,retaildemand,counterpartyadjustment
DOCUMENTS_CHANGE_AGENT_AND_CONTRACT=commissionreportout,commissionreportin
DOCUMENTS_DISCOVERY=salesreturn,customerorder,demand,invoiceout,invoicein,supply,purchaseorder,paymentin,paymentout,cashin,cashout,retaildemand,counterpartyadjustment,commissionreportin,commissionreportout,purchasereturn,retailsalesreturn,factureout,facturein

# Ordinary document counterparty retry: extra retries after the first request,
# with exponential delays of 5, 10, ... seconds. Set retries or delay to 0 to disable it.
DOCUMENTS_PUT_CHANGE_MAX_RETRIES=2
DOCUMENTS_PUT_CHANGE_RETRY_DELAY_MS=5000

# Maximum sanitized upstream response body retained in diagnostics, in characters.
EGRESS_MAX_DIAGNOSTIC_BODY_LENGTH=32768

# Recreation retry settings: total attempts and initial exponential delay.
PURCHASERETURN_RECREATE_MAX_ATTEMPTS=3
PURCHASERETURN_RECREATE_RETRY_DELAY_MS=1000
FACTUREIN_RECREATE_MAX_ATTEMPTS=3
FACTUREIN_RECREATE_RETRY_DELAY_MS=1000
