{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Services": {
    "CatalogSyncService": {
      "BaseUrl": "http://localhost:5013/"
    }
  },
  "InternalApi": {
    "Key": ""
  },
  "Session": {
    "CookieName": "mscontractor.session"
  },
  "ReverseProxy": {
    "Routes": {
      "vendor-api-route": {
        "ClusterId": "vendor-service-cluster",
        "Match": {
          "Path": "/api/moysklad/vendor/{**catch-all}"
        }
      },
      "moysklad-session-route": {
        "ClusterId": "vendor-service-cluster",
        "Match": {
          "Path": "/api/moysklad/session/{**catch-all}"
        }
      },
      "openapi-vendor-service-route": {
        "ClusterId": "openapi-vendor-service-cluster",
        "Match": { "Path": "/_openapi/vendor/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/_openapi/vendor" }]
      },
      "openapi-moysklad-egress-service-route": {
        "ClusterId": "openapi-moysklad-egress-service-cluster",
        "Match": { "Path": "/_openapi/moysklad-egress/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/_openapi/moysklad-egress" }]
      },
      "openapi-catalog-sync-service-route": {
        "ClusterId": "openapi-catalog-sync-service-cluster",
        "Match": { "Path": "/_openapi/catalog-sync/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/_openapi/catalog-sync" }]
      },
      "openapi-duplicates-merge-service-route": {
        "ClusterId": "openapi-duplicates-merge-service-cluster",
        "Match": { "Path": "/_openapi/duplicates-merge/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/_openapi/duplicates-merge" }]
      },
      "openapi-notification-service-route": {
        "ClusterId": "openapi-notification-service-cluster",
        "Match": { "Path": "/_openapi/notification/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/_openapi/notification" }]
      },
      "openapi-audit-service-route": {
        "ClusterId": "openapi-audit-service-cluster",
        "Match": { "Path": "/_openapi/audit/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/_openapi/audit" }]
      }
    },
    "Clusters": {
      "vendor-service-cluster": {
        "Destinations": {
          "vendor-service": {
            "Address": "http://vendor-service:8080/"
          }
        }
      },
      "openapi-vendor-service-cluster": {
        "Destinations": { "vendor-service": { "Address": "http://vendor-service:8080/" } }
      },
      "openapi-moysklad-egress-service-cluster": {
        "Destinations": { "moysklad-egress-service": { "Address": "http://moysklad-egress-service:8080/" } }
      },
      "openapi-catalog-sync-service-cluster": {
        "Destinations": { "catalog-sync-service": { "Address": "http://catalog-sync-service:8080/" } }
      },
      "openapi-duplicates-merge-service-cluster": {
        "Destinations": { "duplicates-merge-service": { "Address": "http://duplicates-merge-service:8080/" } }
      },
      "openapi-notification-service-cluster": {
        "Destinations": { "notification-service": { "Address": "http://notification-service:8080/" } }
      },
      "openapi-audit-service-cluster": {
        "Destinations": { "audit-service": { "Address": "http://audit-service:8080/" } }
      }
    }
  }
}
